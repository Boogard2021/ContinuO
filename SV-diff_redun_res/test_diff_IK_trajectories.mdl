ta_b))) + sin(q3_hl)*(cos(q2_hl)*sin(phi_b) + sin(q2_hl)*(cos(phi_b)*cos(q1_hl)*cos(theta_b) - cos(phi_b)*sin(q1_hl)*sin(theta_b)))) - cos(q4_hl)*(cos(q3_hl)*(cos(q2_hl)*sin(phi_b) + sin(q2_hl)*(cos(phi_b)*cos(q1_hl)*cos(theta_b) - cos(phi_b)*sin(q1_hl)*sin(theta_b))) - sin(q3_hl)*(sin(phi_b)*sin(q2_hl) - cos(q2_hl)*(cos(phi_b)*cos(q1_hl)*cos(theta_b) - cos(phi_b)*sin(q1_hl)*sin(theta_b)))))];

% Reshape 1x60 foot Jacobian vectors into 3x20 matrices:
Jv_fr = reshape(Jv_fr,3,20);
Jv_fl = reshape(Jv_fl,3,20);
Jv_hr = reshape(Jv_hr,3,20);
Jv_hl = reshape(Jv_hl,3,20);

% Body spatial Jacobian
Jb = [eye(6), zeros(6,14)];

%% IK
% Extended Jacobian for EE (foot) tasks
Je = [Jb; Jv_fr; Jv_fl; Jv_hr; Jv_hl]; 
Je_pinv = pinv(Je);

% 6D body task velocity (linear and angular)
vb = [dp0b_d; dqb_d]; 

% Extended task velocity vector for EE (foot) trajectories
dpe = [vb; dp0fr_d; dp0fl_d; dp0hr_d; dp0hl_d];

% Nullspace projector for foot tasks
% N1 = eye(20) - Je_pinv*Je; 

% Compute joint velocities (state vector time-derivative)
% dq = Je_pinv*dpe + N1*Jb*vb; 
dq = Je_pinv*dpe;

end</P>
