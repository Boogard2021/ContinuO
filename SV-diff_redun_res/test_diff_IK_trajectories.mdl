<?xml version="1.0" encoding="utf-8"?>
<chart id="61">
  <P Name="name">MATLAB Function1</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">61</P>
  <P Name="ssIdHighWaterMark">59</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">1</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">IK_diff</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">61</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function dq = IK_diff(d, q_prev, L_h, L_b, W_b, L_sh_f, L_sh_h, L_th_f, L_th_h, L_th_h_mid)
% Computes ContinuO&apos;s inverse kinematics using a differential
%   formulation from the desired velocities of its feet and body and their 
%   positions.
% 
% Syntax: q = IK_diff(d, p)
% 
% Inputs: 
%   d - trajectory vector: 
%       d = [r_p; q_p; r_fr; r_fl; r_hr; r_hl; 
%           dr_p; dq_p; dr_fr; dr_fl; dr_hr; dr_hl;      
%           ddr_p; ddq_p; ddr_fr; ddr_fl; ddr_hr; ddr_hl]
%   p - world frame position vector:
%       p = [p0b; qb; p0fr; p0fl; p0hr; p0hl]
% 
% Outputs:
%   dq - joint velocity vector (state vector time-derivative): 
%       dq = [dr_p; dq_p; dq_fr; dq_fl; dq_hr; dq_hl]
% 
% By Stefan Van de Mosselaer, modified from code by Hossein Keshavarz and
%   Stefan Van de Mosselaer.
% 
% 13-Dec-2024
% 
% TODO: fix docutext

% %% Global
% % From quad_properties.m:
% global L_h L_b W_b % Base (Body) dimensions
% 
% % From quad_parameters.m, limb x, y, and z dimensions:
% global L_sh_f_x L_sh_h_x L_th_f_x L_th_h_x L_th_h_mid_x L_h_x 
% global L_sh_f_y L_sh_h_y L_th_f_y L_th_h_y L_th_h_mid_y L_h_y 
% global L_sh_f_z L_sh_h_z L_th_f_z L_th_h_z L_th_h_mid_z L_h_z

%% Variable Definition
% Actual Base and Foot Positions
% p0b = p(1:3); % Base position (world frame)
% x_b = p0b(1);
% y_b = p0b(2);
% z_b = p0b(3);

% Base rotation angles (world frame)
theta_b = q_prev(4); % Roll
phi_b  = q_prev(5); % Pitch
psi_b = q_prev(6); % Yaw
% 
% p0fr = p(7:9); % Front Right foot position (world frame)
% x_fr = p0fr(1);
% y_fr = p0fr(2);
% z_fr = p0fr(3);
% 
% p0fl = p(10:12); % Front Left foot position (world frame)
% x_fl = p0fl(1);
% y_fl = p0fl(2);
% z_fl = p0fl(3);
% 
% p0hr = p(13:15); % Hind Right foot position (world frame)
% x_hr = p0hr(1);
% y_hr = p0hr(2);
% z_hr = p0hr(3);
% 
% p0hl = p(16:18); % Hind Left foot position (world frame)
% x_hl = p0hl(1);
% y_hl = p0hl(2);
% z_hl = p0hl(3);

%% Previous Timestep Joint Variables (for Jacobians)
q_fr=q_prev(7:9);
q1_fr=q_fr(1);
q2_fr=q_fr(2);
q3_fr=q_fr(3);

q_fl=q_prev(10:12);
q1_fl=q_fl(1);
q2_fl=q_fl(2);
q3_fl=q_fl(3);

q_hr=q_prev(13:16);
q1_hr=q_hr(1);
q2_hr=q_hr(2);
q3_hr=q_hr(3);
q4_hr=q_hr(4);

q_hl=q_prev(17:20);
q1_hl=q_hl(1);
q2_hl=q_hl(2);
q3_hl=q_hl(3);
q4_hl=q_hl(4);

% Trajectory Velocities
dp0b_d = d(19:21); % Desired base velocity (world frame)
dqb_d = d(22:24); % Desired base rotation rate (world frame) (roll, pitch, yaw)
dp0fr_d = d(25:27); % Desired front right foot velocity (world frame)
dp0fl_d = d(28:30); % Desired front left foot velocity (world frame)
dp0hr_d = d(31:33); % Desired hind right foot velocity (world frame)
dp0hl_d = d(34:36); % Desired hind left foot velocity (world frame)

% Robot Parameters for Jacobians
L_sh_f_x = L_sh_f(1);L_sh_h_x = L_sh_h(1);L_th_h_x=L_th_h(1);L_th_f_x=L_th_f(1);L_th_h_mid_x=L_th_h_mid(1);L_h_x=L_h(1);
L_sh_f_y = L_sh_f(2);L_sh_h_y = L_sh_h(2);L_th_h_y=L_th_h(2);L_th_f_y=L_th_f(2);L_th_h_mid_y=L_th_h_mid(2);L_h_y=L_h(2); 
L_sh_f_z = L_sh_f(3);L_sh_h_z = L_sh_h(3);L_th_h_z=L_th_h(3);L_th_f_z=L_th_f(3);L_th_h_mid_z=L_th_h_mid(3);L_h_z=L_h(3); 

% %% Rotation Matrix
% % Body Rotation Matrix
% R_p_x =   rot(1,theta_b,4);
% R_p_y =   rot(2,phi_b,4);
% R_p_z =   rot(3,psi_b,4);
% R0b = R_p_z*R_p_y*R_p_x; % Body Rotation Matrix (4x4)

%% Translation Matrix
% % Base in the World frame
% P0b = trans([],p0b);

% % Translation from Base to Shoulder joint (joint 1)
% Pb1_fr = trans([],0.5*[L_b,-W_b,0]);  
% Pb1_fl = trans([],0.5*[L_b,W_b,0]);
% Pb1_hr = trans([],0.5*[-L_b,-W_b,0]);
% Pb1_hl = trans([],0.5*[-L_b,W_b,0]);

% % Translation from Shoulder (joint 1) to Hip joint (joint 2)
% P12_fr = trans([],[L_h(1),-L_h(2),-L_h(3)]);
% P12_fl = trans([],[L_h(1),L_h(2),-L_h(3)]);
% P12_hr = trans([],[-L_h(1),-L_h(2),-L_h(3)]);
% P12_hl = trans([],[-L_h(1),L_h(2),-L_h(3)]);
% 
% % Position of Shoulder joints (joint 1) in the World frame
% p01_fr =  P0b*R0b*Pb1_fr*[0;0;0;1];
% p01_fl =  P0b*R0b*Pb1_fl*[0;0;0;1];
% p01_hr =  P0b*R0b*Pb1_hr*[0;0;0;1];
% p01_hl =  P0b*R0b*Pb1_hl*[0;0;0;1];

%% Jacobians
% Import foot Jacobians from external script files (computed symbolically,
%   variable values filled from workspace on script run):
% run JJv_fr 
% run JJv_fl
% run JJv_hr
% run JJv_hl

Jv_fr = [1, 0, 0, 0, 1, 0, 0, 0, 1, L_h_z*(sin(psi_b)*sin(q1_fr)*sin(theta_b) - cos(q1_fr)*cos(theta_b)*sin(psi_b) + cos(psi_b)*cos(q1_fr)*sin(phi_b)*sin(theta_b) + cos(psi_b)*cos(theta_b)*sin(phi_b)*sin(q1_fr)) - L_sh_f_y*(cos(q1_fr)*(sin(psi_b)*sin(theta_b) + cos(psi_b)*cos(theta_b)*sin(phi_b)) + sin(q1_fr)*(cos(theta_b)*sin(psi_b) - cos(psi_b)*sin(phi_b)*sin(theta_b))) - L_th_f_y*(cos(q1_fr)*(sin(psi_b)*sin(theta_b) + cos(psi_b)*cos(theta_b)*sin(phi_b)) + sin(q1_fr)*(cos(theta_b)*sin(psi_b) - cos(psi_b)*sin(phi_b)*sin(theta_b))) - (conj(W_b)*(sin(psi_b)*sin(theta_b) + cos(psi_b)*cos(theta_b)*sin(phi_b)))/2 - L_h_y*(cos(q1_fr)*(sin(psi_b)*sin(theta_b) + cos(psi_b)*cos(theta_b)*sin(phi_b)) + sin(q1_fr)*(cos(theta_b)*sin(psi_b) - cos(psi_b)*sin(phi_b)*sin(theta_b))) - L_th_f_z*cos(q2_fr)*(cos(q1_fr)*(cos(theta_b)*sin(psi_b) - cos(psi_b)*sin(phi_b)*sin(theta_b)) - sin(q1_fr)*(sin(psi_b)*sin(theta_b) + cos(psi_b)*cos(theta_b)*sin(phi_b))) + L_sh_f_z*cos(q2_fr + q3_fr)*(sin(psi_b)*sin(q1_fr)*sin(theta_b) - cos(q1_fr)*cos(theta_b)*sin(psi_b) + cos(psi_b)*cos(q1_fr)*sin(phi_b)*sin(theta_b) + cos(psi_b)*cos(theta_b)*sin(phi_b)*sin(q1_fr)) - L_th_f_x*sin(q2_fr)*(cos(q1_fr)*(cos(theta_b)*sin(psi_b) - cos(psi_b)*sin(phi_b)*sin(theta_b)) - sin(q1_fr)*(sin(psi_b)*sin(theta_b) + cos(psi_b)*cos(theta_b)*sin(phi_b))) - L_sh_f_x*sin(q2_fr + q3_fr)*(sin(psi_b)*sin(q1_fr)*sin(theta_b) - cos(q1_fr)*cos(theta_b)*sin(psi_b) + cos(psi_b)*cos(q1_fr)*sin(phi_b)*sin(theta_b) + cos(psi_b)*cos(theta_b)*sin(phi_b)*sin(q1_fr)), L_h_y*(cos(q1_fr)*(cos(psi_b)*sin(theta_b) - cos(theta_b)*sin(phi_b)*sin(psi_b)) + sin(q1_fr)*(cos(psi_b)*cos(theta_b) + sin(phi_b)*sin(psi_b)*sin(theta_b))) + L_sh_f_y*(cos(q1_fr)*(cos(psi_b)*sin(theta_b) - cos(theta_b)*sin(phi_b)*sin(psi_b)) + sin(q1_fr)*(cos(psi_b)*cos(theta_b) + sin(phi_b)*sin(psi_b)*sin(theta_b))) + L_th_f_y*(cos(q1_fr)*(cos(psi_b)*sin(theta_b) - cos(theta_b)*sin(phi_b)*sin(psi_b)) + sin(q1_fr)*(cos(psi_b)*cos(theta_b) + sin(phi_b)*sin(psi_b)*sin(theta_b))) + (conj(W_b)*(cos(psi_b)*sin(theta_b) - cos(theta_b)*sin(phi_b)*sin(psi_b)))/2 + L_h_z*(cos(psi_b)*cos(q1_fr)*cos(theta_b) - cos(psi_b)*sin(q1_fr)*sin(theta_b) + cos(q1_fr)*sin(phi_b)*sin(psi_b)*sin(theta_b) + cos(theta_b)*sin(phi_b)*sin(psi_b)*sin(q1_fr)) + L_sh_f_z*cos(q2_fr + q3_fr)*(cos(psi_b)*cos(q1_fr)*cos(theta_b) - cos(psi_b)*sin(q1_fr)*sin(theta_b) + cos(q1_fr)*sin(phi_b)*sin(psi_b)*sin(theta_b) + cos(theta_b)*sin(phi_b)*sin(psi_b)*sin(q1_fr)) - L_sh_f_x*sin(q2_fr + q3_fr)*(cos(psi_b)*cos(q1_fr)*cos(theta_b) - cos(psi_b)*sin(q1_fr)*sin(theta_b) + cos(q1_fr)*sin(phi_b)*sin(psi_b)*sin(theta_b) + cos(theta_b)*sin(phi_b)*sin(psi_b)*sin(q1_fr)) + L_th_f_z*cos(q2_fr)*(cos(psi_b)*cos(q1_fr)*cos(theta_b) - cos(psi_b)*sin(q1_fr)*sin(theta_b) + cos(q1_fr)*sin(phi_b)*sin(psi_b)*sin(theta_b) + cos(theta_b)*sin(phi_b)*sin(psi_b)*sin(q1_fr)) + L_th_f_x*sin(q2_fr)*(cos(psi_b)*cos(q1_fr)*cos(theta_b) - cos(psi_b)*sin(q1_fr)*sin(theta_b) + cos(q1_fr)*sin(phi_b)*sin(psi_b)*sin(theta_b) + cos(theta_b)*sin(phi_b)*sin(psi_b)*sin(q1_fr)), L_h_z*sin(q1_fr + theta_b)*cos(phi_b) - (cos(phi_b + theta_b)*conj(W_b))/4 - L_h_y*cos(q1_fr + theta_b)*cos(phi_b) - L_sh_f_y*cos(q1_fr + theta_b)*cos(phi_b) - L_th_f_y*cos(q1_fr + theta_b)*cos(phi_b) - (cos(phi_b - theta_b)*conj(W_b))/4 + L_th_f_z*sin(q1_fr + theta_b)*cos(phi_b)*cos(q2_fr) + L_th_f_x*sin(q1_fr + theta_b)*cos(phi_b)*sin(q2_fr) + L_sh_f_z*cos(q2_fr + q3_fr)*sin(q1_fr + theta_b)*cos(phi_b) - L_sh_f_x*sin(q2_fr + q3_fr)*sin(q1_fr + theta_b)*cos(phi_b), L_sh_f_x*(cos(psi_b)*cos(q3_fr)*(cos(q2_fr)*sin(phi_b) + cos(phi_b)*cos(q1_fr)*cos(theta_b)*sin(q2_fr) - cos(phi_b)*sin(q1_fr)*sin(q2_fr)*sin(theta_b)) - cos(psi_b)*sin(q3_fr)*(sin(phi_b)*sin(q2_fr) - cos(phi_b)*cos(q1_fr)*cos(q2_fr)*cos(theta_b) + cos(phi_b)*cos(q2_fr)*sin(q1_fr)*sin(theta_b))) + L_sh_f_z*(cos(psi_b)*cos(q3_fr)*(sin(phi_b)*sin(q2_fr) - cos(phi_b)*cos(q1_fr)*cos(q2_fr)*cos(theta_b) + cos(phi_b)*cos(q2_fr)*sin(q1_fr)*sin(theta_b)) + cos(psi_b)*sin(q3_fr)*(cos(q2_fr)*sin(phi_b) + cos(phi_b)*cos(q1_fr)*cos(theta_b)*sin(q2_fr) - cos(phi_b)*sin(q1_fr)*sin(q2_fr)*sin(theta_b))) - L_h_x*cos(psi_b)*sin(phi_b) + L_th_f_z*cos(psi_b)*(sin(phi_b)*sin(q2_fr) - cos(phi_b)*cos(q1_fr)*cos(q2_fr)*cos(theta_b) + cos(phi_b)*cos(q2_fr)*sin(q1_fr)*sin(theta_b)) - L_th_f_x*cos(psi_b)*(cos(q2_fr)*sin(phi_b) + cos(phi_b)*cos(q1_fr)*cos(theta_b)*sin(q2_fr) - cos(phi_b)*sin(q1_fr)*sin(q2_fr)*sin(theta_b)) - (conj(L_b)*cos(psi_b)*sin(phi_b))/2 - L_h_y*sin(q1_fr + theta_b)*cos(phi_b)*cos(psi_b) - L_sh_f_y*sin(q1_fr + theta_b)*cos(phi_b)*cos(psi_b) - L_th_f_y*sin(q1_fr + theta_b)*cos(phi_b)*cos(psi_b) - (conj(W_b)*cos(phi_b)*cos(psi_b)*sin(theta_b))/2 - L_h_z*cos(q1_fr + theta_b)*cos(phi_b)*cos(psi_b), L_sh_f_x*(cos(q3_fr)*sin(psi_b)*(cos(q2_fr)*sin(phi_b) + cos(phi_b)*cos(q1_fr)*cos(theta_b)*sin(q2_fr) - cos(phi_b)*sin(q1_fr)*sin(q2_fr)*sin(theta_b)) - sin(psi_b)*sin(q3_fr)*(sin(phi_b)*sin(q2_fr) - cos(phi_b)*cos(q1_fr)*cos(q2_fr)*cos(theta_b) + cos(phi_b)*cos(q2_fr)*sin(q1_fr)*sin(theta_b))) + L_sh_f_z*(cos(q3_fr)*sin(psi_b)*(sin(phi_b)*sin(q2_fr) - cos(phi_b)*cos(q1_fr)*cos(q2_fr)*cos(theta_b) + cos(phi_b)*cos(q2_fr)*sin(q1_fr)*sin(theta_b)) + sin(psi_b)*sin(q3_fr)*(cos(q2_fr)*sin(phi_b) + cos(phi_b)*cos(q1_fr)*cos(theta_b)*sin(q2_fr) - cos(phi_b)*sin(q1_fr)*sin(q2_fr)*sin(theta_b))) - L_h_x*sin(phi_b)*sin(psi_b) + L_th_f_z*sin(psi_b)*(sin(phi_b)*sin(q2_fr) - cos(phi_b)*cos(q1_fr)*cos(q2_fr)*cos(theta_b) + cos(phi_b)*cos(q2_fr)*sin(q1_fr)*sin(theta_b)) - L_th_f_x*sin(psi_b)*(cos(q2_fr)*sin(phi_b) + cos(phi_b)*cos(q1_fr)*cos(theta_b)*sin(q2_fr) - cos(phi_b)*sin(q1_fr)*sin(q2_fr)*sin(theta_b)) - (conj(L_b)*sin(phi_b)*sin(psi_b))/2 - L_h_z*cos(q1_fr + theta_b)*cos(phi_b)*sin(psi_b) - L_h_y*sin(q1_fr + theta_b)*cos(phi_b)*sin(psi_b) - L_sh_f_y*sin(q1_fr + theta_b)*cos(phi_b)*sin(psi_b) - L_th_f_y*sin(q1_fr + theta_b)*cos(phi_b)*sin(psi_b) - (conj(W_b)*cos(phi_b)*sin(psi_b)*sin(theta_b))/2, L_h_y*(cos(q1_fr)*sin(phi_b)*sin(theta_b) + cos(theta_b)*