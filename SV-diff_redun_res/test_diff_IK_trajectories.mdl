  </Block>
  <Block BlockType="Demux" Name=" Demux " SID="73::80">
    <PortCounts in="1" out="1"/>
    <P Name="Position">[270, 230, 320, 270]</P>
    <P Name="ZOrder">18</P>
    <P Name="Outputs">1</P>
  </Block>
  <Block BlockType="S-Function" Name=" SFunction " SID="73::79">
    <P Name="Tag">Stateflow S-Function 1</P>
    <PortCounts in="2" out="2"/>
    <P Name="Position">[180, 100, 230, 160]</P>
    <P Name="ZOrder">17</P>
    <P Name="FunctionName">sf_sfun</P>
    <P Name="Parameters">L_b,L_h,L_sh_f,L_sh_h,L_th_f,L_th_h,L_th_h_mid,W_b</P>
    <P Name="PortCounts">[2 2]</P>
